{
  "name": "toggl-track-desktop-wrapper",
  "version": "1.1.2",
  "private": true,
  "description": "A small desktop window for Toggl Track",
  "desktopName": "dev.toggltrack.wrapper",
  "main": "out/main.js",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "audit:fix": "npm audit fix",
    "start": "npm run compile && electron .",
    "build:linux": "npm run compile && electron-builder --linux AppImage --x64",
    "build:win": "npm run compile && electron-builder --win nsis --x64",
    "build:mac": "npm run compile && electron-builder --mac dmg --arm64",
    "build:dir": "npm run compile && electron-builder --dir",
    "integrate:linux": "node scripts/integrate-linux-appimage.cjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "dev.toggltrack.wrapper",
    "productName": "Toggl Track Desktop",
    "publish": {
      "provider": "github",
      "owner": "AlexVedun",
      "repo": "TogglTrackDesktopApp"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/512x512.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "artifactName": "Toggl.Track.Desktop-${version}.${ext}",
      "category": "Office",
      "icon": "build/icons",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "artifactName": "Toggl.Track.Desktop.Setup.${version}.${ext}"
    },
    "mac": {
      "artifactName": "Toggl.Track.Desktop-${version}-${arch}.${ext}",
      "identity": null
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
